        "id": "load-path",
        "label": "Load path",
        "focus": ["regfile", "immediate", "alu", "memory_request", "dmem", "writeback"],
        "note": "See effective-address generation, the held data-memory request, load alignment, and destination-register writeback."
      },
      {
        "id": "control-and-trap",
        "label": "Control and trap path",
        "focus": ["controller", "decoder", "pc", "memory_request", "trap_retire"],
        "note": "The four-state controller owns progress; alignment, decode, and access faults enter a sticky external trap record."
      }
    ]
