  "cards": [
    {
      "dot": "cyan",
      "title": "Architectural Contract",
      "items": [
        "Unprivileged RV32I with 32-bit byte addresses and IALIGN=32",
        "No pipeline hazards: one instruction owns the datapath",
        "No CSRs, interrupts, caches, MMU, M, or C extension"
      ]
    },
    {
      "dot": "emerald",
      "title": "Interface Invariants",
      "items": [
        "Instruction and data requests remain stable until ready",
        "Only one native memory request is outstanding",
        "Misaligned control transfers and data accesses trap"
      ]
    },
    {
      "dot": "rose",
      "title": "Verification Evidence",
      "items": [
        "Verilator lint and cocotb retirement scoreboard pass",
        "Icarus directed, ALU, and trap suites pass",
        "Simulation evidence does not claim FPGA timing closure"
      ]
    }
